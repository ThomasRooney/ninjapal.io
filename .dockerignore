# Never bake secrets or local state into images (Dockerfile.sync does COPY . .).
.env
.env.*
*.local
mise.local.toml

# Build/runtime state — the image runs bun install itself.
node_modules
.output
.vercel
.nitro
.tanstack
dist
cdk.out
playwright-report
test-results

# VCS + agent worktrees + infra (deployed separately, never part of the app image)
.git
.claude
infra/aws/node_modules
infra/aws/cdk.out
marketing/node_modules
